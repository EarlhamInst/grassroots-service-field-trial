# Otherwise set it to the directory containing libvips's "include" and
# "lib" subdirectories.
#export LIBVIPS_HOME := /opt/libvips


# If you want to compile with the MARTi integration enabled, set this directory 
# to where the Grassroots MARTi service (https://github.com/TGAC/grassroots-service-marti)
# is checked out to
export DIR_MARTI := /Users/tyrrells/Projects/grassroots/services/marti


